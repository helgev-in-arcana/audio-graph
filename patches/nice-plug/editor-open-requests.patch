+    safe: AtomicBool,
+    accept: AtomicBool,
+}
+
+impl Handler {
+    fn check_locks(&self) {
+        let wrapper = self.wrapper.upgrade().unwrap();
+        let free = wrapper.plugin.try_lock().is_some()
+            && wrapper.task_executor.try_lock().is_some()
+            && wrapper.component_handler.try_borrow_mut().is_ok();
+        self.safe.fetch_and(free, Ordering::Relaxed);
+    }
+}
+
+impl Class for Handler {
+    type Interfaces = (IComponentHandler, IComponentHandler2);
+}
+impl IComponentHandlerTrait for Handler {
+    unsafe fn beginEdit(&self, _: u32) -> tresult {
+        kResultOk
+    }
+    unsafe fn performEdit(&self, _: u32, _: f64) -> tresult {
+        kResultOk
+    }
+    unsafe fn endEdit(&self, _: u32) -> tresult {
+        kResultOk
+    }
+    unsafe fn restartComponent(&self, _: i32) -> tresult {
+        let wrapper = self.wrapper.upgrade().unwrap();
+        self.safe
+            .fetch_and(wrapper.plugin.try_lock().is_some(), Ordering::Relaxed);
+        kResultOk
+    }
+}
+impl IComponentHandler2Trait for Handler {
+    unsafe fn setDirty(&self, _: TBool) -> tresult {
+        kResultOk
+    }
+    unsafe fn startGroupEdit(&self) -> tresult {
+        kResultOk
+    }
+    unsafe fn finishGroupEdit(&self) -> tresult {
+        kResultOk
+    }
+    unsafe fn requestOpenEditor(&self, name: FIDString) -> tresult {
+        self.check_locks();
+        self.safe.fetch_and(
+            unsafe { std::ffi::CStr::from_ptr(name) } == c"editor",
+            Ordering::Relaxed,
+        );
+        self.shows.fetch_add(1, Ordering::Relaxed);
+        if self.accept.load(Ordering::Relaxed) {
+            kResultOk
+        } else {
+            kResultFalse
+        }
+    }
+}
+
+struct LegacyHandler;
+impl Class for LegacyHandler {
+    type Interfaces = (IComponentHandler,);
+}
+impl IComponentHandlerTrait for LegacyHandler {
+    unsafe fn beginEdit(&self, _: u32) -> tresult {
+        kResultOk
+    }
+    unsafe fn performEdit(&self, _: u32, _: f64) -> tresult {
+        kResultOk
+    }
+    unsafe fn endEdit(&self, _: u32) -> tresult {
+        kResultOk
+    }
+    unsafe fn restartComponent(&self, _: i32) -> tresult {
+        kResultOk
+    }
+}
+
+fn pump() {
+    let mut message = MSG::default();
+    while unsafe { PeekMessageW(&mut message, None, 0, 0, PM_REMOVE) }.as_bool() {
+        unsafe {
+            DispatchMessageW(&message);
+        }
+    }
+}
+
+/// Disconnected, activation, reload, and worker requests use the OS queue with no held wrapper locks.
+#[test]
+fn requests_defer_and_survive_connection_until_the_main_loop_runs() {
+    let wrapper = Wrapper::<RequestPlugin>::new();
+    let handler = ComWrapper::new(Handler {
+        wrapper: Arc::downgrade(&wrapper.inner),
+        shows: AtomicUsize::new(0),
+        safe: AtomicBool::new(true),
+        accept: AtomicBool::new(true),
+    });
+    let executor = wrapper.inner.plugin.lock().executor.get().unwrap().clone();
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    executor.request_editor_open(request);
+    pump();
+    assert_eq!(handle.status(), EditorOpenStatus::Pending);
+    assert!(wrapper.inner.pending_editor_open.lock().is_some());
+    unsafe {
+        wrapper.setComponentHandler(handler.as_com_ref::<IComponentHandler>().unwrap().as_ptr());
+    }
+    assert_eq!(handler.shows.load(Ordering::Relaxed), 0);
+    pump();
+    assert_eq!(handle.status(), EditorOpenStatus::Accepted);
+    wrapper
+        .inner
+        .current_buffer_config
+        .store(Some(BufferConfig {
+            sample_rate: 48_000.0,
+            min_buffer_size: None,
+            max_buffer_size: 64,
+            process_mode: ProcessMode::Realtime,
+        }));
+    unsafe {
+        assert_eq!(wrapper.setActive(1), kResultOk);
+    }
+    assert_eq!(handler.shows.load(Ordering::Relaxed), 1);
+    pump();
+    assert_eq!(
+        wrapper.inner.plugin.lock().requests[0].status(),
+        EditorOpenStatus::Accepted
+    );
+    assert!(wrapper.inner.set_state_inner(&mut empty_state()));
+    assert_eq!(handler.shows.load(Ordering::Relaxed), 2);
+    pump();
+    assert_eq!(handler.shows.load(Ordering::Relaxed), 3);
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    std::thread::spawn(move || executor.execute_gui(request))
+        .join()
+        .unwrap();
+    pump();
+    assert_eq!(handle.status(), EditorOpenStatus::Accepted);
+    assert_eq!(handler.shows.load(Ordering::Relaxed), 4);
+    assert!(handler.safe.load(Ordering::Relaxed));
+    unsafe {
+        wrapper.setComponentHandler(std::ptr::null_mut());
+    }
+}
