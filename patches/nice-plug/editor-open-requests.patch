@@ -0,0 +1,138 @@
+//! A cancellable request to show the plugin's own editor, independent of any open window.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU8, Ordering};
+
+/// Host acceptance does not mean that a window has finished opening or gained focus.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[repr(u8)]
+pub enum EditorOpenStatus {
+    Pending,
+    Dispatching,
+    Accepted,
+    Unsupported,
+    Rejected,
+    Cancelled,
+}
+
+/// The sending half. Dropping an unhandled request cancels it.
+///
+/// Allocate this on a non-audio thread, then keep a [`Self::handle`] to observe or cancel it.
+pub struct EditorOpenRequest(Arc<AtomicU8>);
+
+/// An observer that can cancel a request until the host call begins.
+#[derive(Clone)]
+pub struct EditorOpenHandle(Arc<AtomicU8>);
+
+impl Default for EditorOpenRequest {
+    fn default() -> Self {
+        Self(Arc::new(AtomicU8::new(EditorOpenStatus::Pending as u8)))
+    }
+}
+
+impl EditorOpenRequest {
+    pub fn handle(&self) -> EditorOpenHandle {
+        EditorOpenHandle(self.0.clone())
+    }
+
+    pub fn is_pending(&self) -> bool {
+        self.0.load(Ordering::Acquire) == EditorOpenStatus::Pending as u8
+    }
+
+    /// For wrapper implementations: invoke the host only if the request is still live.
+    /// No plugin, editor, or host-interface lock may be held while running `send`.
+    pub fn dispatch(self, send: impl FnOnce() -> EditorOpenStatus) {
+        if self
+            .0
+            .compare_exchange(
+                EditorOpenStatus::Pending as u8,
+                EditorOpenStatus::Dispatching as u8,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .is_ok()
+        {
+            let result = send();
+            assert!(matches!(
+                result,
+                EditorOpenStatus::Accepted
+                    | EditorOpenStatus::Unsupported
+                    | EditorOpenStatus::Rejected
+            ));
+            self.0.store(result as u8, Ordering::Release);
+        }
+    }
+}
+
+impl Drop for EditorOpenRequest {
+    fn drop(&mut self) {
+        let _ = self
+            .0
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |status| {
+                (status <= EditorOpenStatus::Dispatching as u8)
+                    .then_some(EditorOpenStatus::Cancelled as u8)
+            });
+    }
+}
+
+impl EditorOpenHandle {
+    pub fn status(&self) -> EditorOpenStatus {
+        match self.0.load(Ordering::Acquire) {
+            0 => EditorOpenStatus::Pending,
+            1 => EditorOpenStatus::Dispatching,
+            2 => EditorOpenStatus::Accepted,
+            3 => EditorOpenStatus::Unsupported,
+            4 => EditorOpenStatus::Rejected,
+            _ => EditorOpenStatus::Cancelled,
+        }
+    }
+
+    /// Returns false if dispatch has already begun or the request has finished.
+    pub fn cancel(&self) -> bool {
+        self.0
+            .compare_exchange(
+                EditorOpenStatus::Pending as u8,
+                EditorOpenStatus::Cancelled as u8,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .is_ok()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Cancelling queued work prevents a stale request from reaching the host.
+    #[test]
+    fn cancellation_prevents_dispatch() {
+        let request = EditorOpenRequest::default();
+        let handle = request.handle();
+        assert!(handle.cancel());
+        request.dispatch(|| panic!("cancelled request reached the host"));
+        assert_eq!(handle.status(), EditorOpenStatus::Cancelled);
+    }
+
+    /// Acceptance survives sender destruction and cannot be revoked after dispatch begins.
+    #[test]
+    fn dispatch_has_a_terminal_result() {
+        let request = EditorOpenRequest::default();
+        let handle = request.handle();
+        request.dispatch(|| {
+            assert_eq!(handle.status(), EditorOpenStatus::Dispatching);
+            assert!(!handle.cancel());
+            EditorOpenStatus::Accepted
+        });
+        assert_eq!(handle.status(), EditorOpenStatus::Accepted);
+    }
+
+    /// Destroying a queue or wrapper settles its outstanding requests.
+    #[test]
+    fn dropping_the_sender_cancels_the_request() {
+        let request = EditorOpenRequest::default();
+        let handle = request.handle();
+        drop(request);
+        assert_eq!(handle.status(), EditorOpenStatus::Cancelled);
+    }
+}
