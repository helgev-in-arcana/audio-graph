@@ -169,8 +170,28 @@ impl<P: Plugin> AsyncExecutor<P> {
         Self {
             execute_background,
             execute_gui,
+            request_editor_open: Arc::new(|request| {
+                request.dispatch(|| super::editor_request::EditorOpenStatus::Unsupported);
+            }),
         }
     }
+
+    /// For wrapper implementations: install a sender that always defers host calls to the main thread.
+    pub fn with_editor_request_handler(
+        mut self,
+        handler: Arc<dyn Fn(super::editor_request::EditorOpenRequest) + Send + Sync>,
+    ) -> Self {
+        self.request_editor_open = handler;
+        self
+    }
+
+    /// Request this plugin's editor even if no editor window has been opened.
+    /// The host call is deferred; the request's handle distinguishes acceptance from queueing.
+    /// A full queue, destruction, or reentry into a busy plugin cancels the request. Callers may
+    /// retry cancellation later, but should not repeatedly retry host refusal or missing support.
+    pub fn request_editor_open(&self, request: super::editor_request::EditorOpenRequest) {
+        (self.request_editor_open)(request);
+    }
 }
 
