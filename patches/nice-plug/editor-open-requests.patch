+/// Refusal, unsupported optional interfaces, and destroyed wrappers have distinct terminal outcomes.
+#[test]
+fn requests_do_not_claim_success_when_the_host_cannot_show() {
+    let wrapper = Wrapper::<RequestPlugin>::new();
+    let handler = ComWrapper::new(Handler {
+        wrapper: Arc::downgrade(&wrapper.inner),
+        shows: AtomicUsize::new(0),
+        safe: AtomicBool::new(true),
+        accept: AtomicBool::new(false),
+    });
+    unsafe {
+        wrapper.setComponentHandler(handler.as_com_ref::<IComponentHandler>().unwrap().as_ptr());
+    }
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    wrapper.inner.request_editor_open(request);
+    pump();
+    assert_eq!(handle.status(), EditorOpenStatus::Rejected);
+    let request = EditorOpenRequest::default();
+    request.handle().cancel();
+    wrapper.inner.request_editor_open(request);
+    pump();
+    assert_eq!(handler.shows.load(Ordering::Relaxed), 1);
+    let legacy = ComWrapper::new(LegacyHandler);
+    unsafe {
+        wrapper.setComponentHandler(legacy.as_com_ref::<IComponentHandler>().unwrap().as_ptr());
+    }
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    wrapper.inner.request_editor_open(request);
+    pump();
+    assert_eq!(handle.status(), EditorOpenStatus::Unsupported);
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    wrapper.inner.request_editor_open(request);
+    drop(wrapper);
+    assert_eq!(handle.status(), EditorOpenStatus::Cancelled);
+}
+
+/// A host pumping messages during plugin work cannot reenter the locked plugin through this request.
+#[test]
+fn nested_message_delivery_does_not_call_the_host() {
+    let wrapper = Wrapper::<RequestPlugin>::new();
+    let plugin = wrapper.inner.plugin.lock();
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    wrapper.inner.request_editor_open(request);
+    pump();
+    assert_eq!(handle.status(), EditorOpenStatus::Cancelled);
+    assert!(wrapper.inner.pending_editor_open.lock().is_none());
+    drop(plugin);
+}
