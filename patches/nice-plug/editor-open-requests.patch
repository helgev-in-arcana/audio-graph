+#[derive(Default)]
+pub(crate) struct RequestPlugin {
+    pub requests: Vec<EditorOpenHandle>,
+    pub executor: Arc<OnceLock<AsyncExecutor<Self>>>,
+    activations: u32,
+}
+
+impl Plugin for RequestPlugin {
+    const NAME: &'static str = "Editor request fixture";
+    const VENDOR: &'static str = "nice-plug";
+    const URL: &'static str = "https://codeberg.org/RustAudio/nice-plug";
+    const EMAIL: &'static str = "";
+    const VERSION: &'static str = "0.0.0";
+    const AUDIO_IO_LAYOUTS: &'static [AudioIOLayout] = &[AudioIOLayout::const_default()];
+    type Editor = ();
+    type SysExMessage = ();
+    type BackgroundTask = EditorOpenRequest;
+
+    fn params(&self) -> Arc<dyn Params> {
+        Arc::new(EmptyParams)
+    }
+
+    fn editor(&mut self, executor: AsyncExecutor<Self>) -> Option<Self::Editor> {
+        let _ = self.executor.set(executor);
+        Some(())
+    }
+
+    fn task_executor(&mut self) -> TaskExecutor<Self> {
+        let executor = self.executor.clone();
+        Box::new(move |request| executor.get().unwrap().request_editor_open(request))
+    }
+
+    fn activate(
+        &mut self,
+        _: &AudioIOLayout,
+        _: &BufferConfig,
+        context: &mut impl ActivateContext<Self>,
+    ) -> bool {
+        self.activations += 1;
+        context.set_latency_samples(self.activations);
+        let request = EditorOpenRequest::default();
+        self.requests.push(request.handle());
+        context.request_editor_open(request);
+        true
+    }
+
+    fn process(
+        &mut self,
+        _: &mut Buffer,
+        _: &mut AuxiliaryBuffers,
+        _: &mut impl ProcessContext<Self>,
+    ) -> ProcessStatus {
+        ProcessStatus::Normal
+    }
+}
+
+impl ClapPlugin for RequestPlugin {
+    const CLAP_ID: &'static str = "org.nice-plug.editor-request-test";
+    const CLAP_DESCRIPTION: Option<&'static str> = None;
+    const CLAP_MANUAL_URL: Option<&'static str> = None;
+    const CLAP_SUPPORT_URL: Option<&'static str> = None;
+    const CLAP_FEATURES: &'static [ClapFeature] = &[];
+}
+
+#[cfg(feature = "vst3")]
+impl Vst3Plugin for RequestPlugin {
+    const VST3_CLASS_ID: [u8; 16] = *b"EditorRequestTst";
+    const VST3_SUBCATEGORIES: &'static [Vst3SubCategory] = &[];
+}
+
+pub(crate) fn empty_state() -> PluginState {
+    PluginState {
+        version: "0.0.0".into(),
+        params: Default::default(),
+        fields: Default::default(),
+    }
+}
