diff --git a/crates/nice-plug/src/wrapper/clap/wrapper/editor_request_tests.rs b/crates/nice-plug/src/wrapper/clap/wrapper/editor_request_tests.rs
new file mode 100644
index 00000000..3df4bbf3
--- /dev/null
+++ b/crates/nice-plug/src/wrapper/clap/wrapper/editor_request_tests.rs
@@ -0,0 +1,204 @@
+use super::*;
+use crate::wrapper::editor_request_tests::{RequestPlugin, empty_state};
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicUsize;
+
+struct Host {
+    wrapper: OnceLock<Weak<Wrapper<RequestPlugin>>>,
+    callbacks: AtomicUsize,
+    shows: AtomicUsize,
+    locks_free: AtomicBool,
+    accept: bool,
+    supports_gui: bool,
+}
+
+impl Host {
+    fn check_locks(&self) {
+        let wrapper = self.wrapper.get().unwrap().upgrade().unwrap();
+        let free = wrapper.is_main_thread()
+            && wrapper.plugin.try_lock().is_some()
+            && wrapper.task_executor.try_lock().is_some()
+            && wrapper.host_gui.try_borrow_mut().is_ok();
+        self.locks_free.fetch_and(free, Ordering::Relaxed);
+    }
+}
+
+unsafe fn host_data<'a>(host: *const clap_host) -> &'a Host {
+    unsafe { &*((*host).host_data as *const Host) }
+}
+
+unsafe extern "C" fn show(host: *const clap_host) -> bool {
+    let data = unsafe { host_data(host) };
+    data.check_locks();
+    data.shows.fetch_add(1, Ordering::Relaxed);
+    data.accept
+}
+
+unsafe extern "C" fn restart(host: *const clap_host) {
+    unsafe { host_data(host) }.check_locks();
+}
+unsafe extern "C" fn callback(host: *const clap_host) {
+    unsafe { host_data(host) }
+        .callbacks
+        .fetch_add(1, Ordering::Relaxed);
+}
+
+unsafe extern "C" fn extension(
+    host: *const clap_host,
+    id: *const std::ffi::c_char,
+) -> *const c_void {
+    static GUI: clap_host_gui = clap_host_gui {
+        resize_hints_changed: None,
+        request_resize: None,
+        request_show: Some(show),
+        request_hide: None,
+        closed: None,
+    };
+    static LATENCY: clap_host_latency = clap_host_latency {
+        changed: Some(restart),
+    };
+    match unsafe { CStr::from_ptr(id) } {
+        id if id == CLAP_EXT_GUI && unsafe { host_data(host) }.supports_gui => {
+            &GUI as *const _ as *const c_void
+        }
+        id if id == CLAP_EXT_LATENCY => &LATENCY as *const _ as *const c_void,
+        _ => std::ptr::null(),
+    }
+}
+
+fn fixture(
+    accept: bool,
+    supports_gui: bool,
+) -> (Arc<Wrapper<RequestPlugin>>, Box<clap_host>, Box<Host>) {
+    let mut data = Box::new(Host {
+        wrapper: OnceLock::new(),
+        callbacks: AtomicUsize::new(0),
+        shows: AtomicUsize::new(0),
+        locks_free: AtomicBool::new(true),
+        accept,
+        supports_gui,
+    });
+    let host = Box::new(clap_host {
+        clap_version: clap_sys::version::CLAP_VERSION,
+        host_data: &mut *data as *mut _ as *mut c_void,
+        name: c"request test".as_ptr(),
+        vendor: c"nice-plug".as_ptr(),
+        url: c"".as_ptr(),
+        version: c"1".as_ptr(),
+        get_extension: Some(extension),
+        request_restart: Some(restart),
+        request_process: None,
+        request_callback: Some(callback),
+    });
+    let wrapper = unsafe { Wrapper::<RequestPlugin>::new(&*host) };
+    data.wrapper.set(Arc::downgrade(&wrapper)).ok().unwrap();
+    (wrapper, host, data)
+}
+
+/// Activation and preset reload release their plugin locks before host callbacks can reenter.
+#[test]
+fn activation_and_reload_notify_after_unlocking() {
+    let (wrapper, _host, data) = fixture(true, true);
+    let plugin = wrapper.clap_plugin.as_ptr();
+    unsafe {
+        assert!(Wrapper::<RequestPlugin>::init(plugin));
+        assert!(Wrapper::<RequestPlugin>::activate(plugin, 48_000.0, 1, 64));
+    }
+    assert_eq!(data.shows.load(Ordering::Relaxed), 0);
+    assert_eq!(
+        wrapper.plugin.lock().requests[0].status(),
+        EditorOpenStatus::Pending
+    );
+    unsafe {
+        Wrapper::<RequestPlugin>::on_main_thread(plugin);
+    }
+    assert_eq!(
+        wrapper.plugin.lock().requests[0].status(),
+        EditorOpenStatus::Accepted
+    );
+    assert!(wrapper.set_state_inner(&mut empty_state()));
+    assert_eq!(data.shows.load(Ordering::Relaxed), 1);
+    unsafe {
+        Wrapper::<RequestPlugin>::on_main_thread(plugin);
+    }
+    assert_eq!(data.shows.load(Ordering::Relaxed), 2);
+    assert!(data.locks_free.load(Ordering::Relaxed));
+    drop(wrapper);
+}
+
+/// A closed, inactive editor can be requested from a worker, with cancellation and rejection observable.
+#[test]
+fn requests_work_without_activation_or_an_open_editor() {
+    let (wrapper, _host, data) = fixture(false, true);
+    let executor = wrapper.plugin.lock().executor.get().unwrap().clone();
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    executor.request_editor_open(request);
+    assert_eq!(data.callbacks.load(Ordering::Relaxed), 0);
+    unsafe {
+        assert!(Wrapper::<RequestPlugin>::init(wrapper.clap_plugin.as_ptr()));
+        Wrapper::<RequestPlugin>::on_main_thread(wrapper.clap_plugin.as_ptr());
+    }
+    assert_eq!(handle.status(), EditorOpenStatus::Rejected);
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    std::thread::spawn(move || executor.execute_gui(request))
+        .join()
+        .unwrap();
+    unsafe {
+        Wrapper::<RequestPlugin>::on_main_thread(wrapper.clap_plugin.as_ptr());
+    }
+    assert_eq!(handle.status(), EditorOpenStatus::Rejected);
+    assert_eq!(data.shows.load(Ordering::Relaxed), 2);
+    let request = EditorOpenRequest::default();
+    request.handle().cancel();
+    wrapper.request_editor_open(request);
+    unsafe {
+        Wrapper::<RequestPlugin>::on_main_thread(wrapper.clap_plugin.as_ptr());
+    }
+    assert_eq!(data.shows.load(Ordering::Relaxed), 2);
+    assert!(data.locks_free.load(Ordering::Relaxed));
+    drop(wrapper);
+}
+
+/// Missing host support and destruction settle requests without native GUI calls.
+#[test]
+fn unsupported_and_destroyed_hosts_do_not_open() {
+    let (wrapper, _host, data) = fixture(true, false);
+    unsafe {
+        assert!(Wrapper::<RequestPlugin>::init(wrapper.clap_plugin.as_ptr()));
+    }
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    wrapper.request_editor_open(request);
+    unsafe {
+        Wrapper::<RequestPlugin>::on_main_thread(wrapper.clap_plugin.as_ptr());
+    }
+    assert_eq!(handle.status(), EditorOpenStatus::Unsupported);
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    wrapper.request_editor_open(request);
+    drop(wrapper);
+    assert_eq!(handle.status(), EditorOpenStatus::Cancelled);
+    assert_eq!(data.shows.load(Ordering::Relaxed), 0);
+}
+
+/// Pumping a nested main loop must not call the host while the plugin or task executor is locked.
+#[test]
+fn reentered_delivery_is_cancelled_without_a_host_call() {
+    let (wrapper, _host, data) = fixture(true, true);
+    unsafe {
+        assert!(Wrapper::<RequestPlugin>::init(wrapper.clap_plugin.as_ptr()));
+    }
+    let plugin = wrapper.plugin.lock();
+    let request = EditorOpenRequest::default();
+    let handle = request.handle();
+    wrapper.request_editor_open(request);
+    unsafe {
+        Wrapper::<RequestPlugin>::on_main_thread(wrapper.clap_plugin.as_ptr());
+    }
+    assert_eq!(handle.status(), EditorOpenStatus::Cancelled);
+    assert_eq!(data.shows.load(Ordering::Relaxed), 0);
+    drop(plugin);
+    drop(wrapper);
+}
